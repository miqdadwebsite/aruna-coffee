---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ValueProps from "../components/ValueProps.astro";
import BrandStory from "../components/BrandStory.astro";
import SignatureMenu from "../components/SignatureMenu.astro";
import Ambience from "../components/Ambience.astro";
import Testimonials from "../components/Testimonials.astro";
import Visit from "../components/Visit.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
	<Navbar />
	<Hero />
	<ValueProps />
	<BrandStory />
	<SignatureMenu />
	<Ambience />
	<Testimonials />
	<Visit />
	<Footer />
</Layout>

<style>
	/* Smooth scrolling for anchor links */
	html {
		scroll-behavior: smooth;
	}
</style>
