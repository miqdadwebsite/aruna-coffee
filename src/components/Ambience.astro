---
const slides = [
	{
		id: "slide-1",
		title: "Suasana Nyaman",
		description: "Tempat tenang untuk menikmati kopi di pagi hari.",
		image: "https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&q=80&w=1200&h=480",
		alt: "Cafe interior",
	},
	{
		id: "slide-2",
		title: "Biji Kopi Pilihan",
		description:
			"Dipilih dengan cermat dan dipanggang untuk menghasilkan cita rasa terbaik.",
		image: "https://images.unsplash.com/photo-1600093463592-8e36ae95ef56?auto=format&fit=crop&q=80&w=1200&h=480",
		alt: "Coffee beans",
	},
	{
		id: "slide-3",
		title: "Tempat yang Nyaman",
		description:
			"Datang sendiri, bertemu teman, atau menyelesaikan pekerjaan.",
		image: "https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&q=80&w=1200&h=480",
		alt: "Cozy seating",
	},
	{
		id: "slide-4",
		title: "Barista Berpengalaman",
		description:
			"Setiap cangkir dibuat dengan perhatian pada setiap detail.",
		image: "https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&q=80&w=1200&h=480",
		alt: "Barista",
	},
];
---

<!-- Ambience Section -->
<section id="ambience" class="py-24 bg-brand-bg">
	<div class="container mx-auto px-6 lg:px-12 max-w-7xl">
		<div
			class="md:divider text-4xl md:text-5xl font-serif font-bold text-brand-primary mb-12"
		>
			Lebih dari<br class="sm:hidden" /> Sekadar Kopi
		</div>

		<!-- Carousel with Indicator Buttons (JS-driven) -->
		<div class="relative w-full">
			<div
				id="ambience-carousel"
				class="carousel carousel-end snap-x snap-mandatory w-full rounded-box shadow-2xl overflow-x-auto"
				style="height: 480px;"
			>
				{
					slides.map((slide, index) => (
						<div
							class="carousel-item relative w-full shrink-0 snap-center cursor-pointer"
							data-index={index}
						>
							<img
								src={slide.image}
								alt={slide.alt}
								class="w-full h-full object-cover pointer-events-none select-none"
								loading={index === 0 ? "eager" : "lazy"}
							/>
							<div class="absolute bottom-0 left-0 right-0 h-40 bg-linear-to-t from-black/70 to-transparent pointer-events-none" />
							<div class="absolute bottom-6 left-8 right-8 text-white pointer-events-none">
								<p class="font-serif text-2xl font-medium">
									{slide.title}
								</p>
								<p class="text-white/80 mt-1">
									{slide.description}
								</p>
							</div>
						</div>
					))
				}
			</div>

			<!-- Indicator Buttons -->
			<div
				id="carousel-indicators"
				class="flex justify-center gap-2 mt-5"
			>
				{
					slides.map((slide, index) => (
						<button
							data-index={index}
							class={`carousel-dot btn btn-sm rounded-full w-9 h-9 min-h-0 text-white border-none font-semibold transition-all duration-300 ${index === 0 ? "" : "opacity-50"}`}
							style="background-color: var(--color-brand-primary);"
						>
							{index + 1}
						</button>
					))
				}
			</div>
		</div>
	</div>

	<!-- Lightbox Modal -->
	<dialog id="ambience-modal" class="modal modal-middle">
		<div
			class="modal-box w-screen max-w-none h-screen max-h-none m-0 rounded-none bg-transparent p-0"
		>
			<form method="dialog">
				<button
					class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 z-10 text-white bg-black/40 hover:bg-black/60 border-none"
					aria-label="Close"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="w-6 h-6"
					>
						<path d="M18 6 6 18"></path>
						<path d="m6 6 12 12"></path>
					</svg>
				</button>
			</form>

			<button
				id="modal-prev"
				class="btn btn-circle btn-ghost absolute left-4 top-1/2 -translate-y-1/2 z-10 text-white bg-black/40 hover:bg-black/60 border-none"
				aria-label="Previous"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="w-6 h-6"
				>
					<path d="m15 18-6-6 6-6"></path>
				</svg>
			</button>

			<button
				id="modal-next"
				class="btn btn-circle btn-ghost absolute right-4 top-1/2 -translate-y-1/2 z-10 text-white bg-black/40 hover:bg-black/60 border-none"
				aria-label="Next"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="w-6 h-6"
				>
					<path d="m9 18 6-6-6-6"></path>
				</svg>
			</button>

			<div
				class="relative w-full h-full flex items-center justify-center"
			>
				<img
					id="modal-image"
					src=""
					alt=""
					class="w-full h-full object-contain select-none"
				/>
				<div
					class="absolute bottom-0 left-0 right-0 h-44 bg-linear-to-t from-black/70 to-transparent pointer-events-none"
				>
				</div>
				<div
					class="absolute bottom-6 left-8 right-8 text-white pointer-events-none"
				>
					<p
						id="modal-title"
						class="font-serif text-2xl md:text-3xl font-medium"
					>
					</p>
					<p id="modal-desc" class="text-white/80 mt-1"></p>
				</div>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
</section>

<script define:vars={{ slides }}>
	const track = document.getElementById("ambience-carousel");
	const dots = document.querySelectorAll(".carousel-dot");
	const items = track?.querySelectorAll("[data-index]");
	const modal = document.getElementById("ambience-modal");
	const modalImage = document.getElementById("modal-image");
	const modalTitle = document.getElementById("modal-title");
	const modalDesc = document.getElementById("modal-desc");
	const modalPrev = document.getElementById("modal-prev");
	const modalNext = document.getElementById("modal-next");

	let currentIndex = 0;

	function goTo(index) {
		if (!track || !items) return;
		if (!items[index]) return;
		track.scrollTo({ left: items[index].offsetLeft, behavior: "smooth" });
		dots.forEach((dot, i) => {
			dot.style.opacity = i === index ? "1" : "0.5";
		});
	}

	function renderModal() {
		const slide = slides[currentIndex];
		if (!slide) return;
		if (modalImage) {
			modalImage.src = slide.image;
			modalImage.alt = slide.alt;
		}
		if (modalTitle) modalTitle.textContent = slide.title;
		if (modalDesc) modalDesc.textContent = slide.description;
	}

	function openModal(index) {
		currentIndex = index;
		renderModal();
		modal?.showModal();
	}

	function navigate(delta) {
		currentIndex = (currentIndex + delta + slides.length) % slides.length;
		renderModal();
	}

	dots.forEach((dot, i) => {
		dot.addEventListener("click", () => goTo(i));
	});

	items?.forEach((item, i) => {
		item.addEventListener("click", () => openModal(i));
	});

	modalPrev?.addEventListener("click", () => navigate(-1));
	modalNext?.addEventListener("click", () => navigate(1));

	modal?.addEventListener("keydown", (e) => {
		if (e.key === "ArrowLeft") navigate(-1);
		if (e.key === "ArrowRight") navigate(1);
	});

	track?.addEventListener("scroll", () => {
		if (!items || !items.length) return;
		const activeIndex = Math.round(track.scrollLeft / items[0].offsetWidth);
		const clamped = Math.min(Math.max(activeIndex, 0), items.length - 1);
		dots.forEach((dot, i) => {
			dot.style.opacity = i === clamped ? "1" : "0.5";
		});
	});
</script>
