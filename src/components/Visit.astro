---
import { siteConfig } from '../data/config';
---

<!-- Location & Reservation Section -->
<section id="visit" class="hero py-24 bg-brand-bg-alt text-brand-text">
	<div class="hero-content flex-col lg:flex-row gap-16 w-full max-w-6xl">
		<!-- Info Side -->
		<div class="flex-1 w-full text-center lg:text-left">
			<div
				class="divider divider-start text-4xl md:text-5xl font-serif font-bold text-brand-primary mb-8"
			>
				Kunjungi Kami
			</div>

			<p class="text-lg mb-4">
				<strong class="font-bold">{siteConfig.brandName}</strong><br />
				{siteConfig.contact.address}
			</p>

			<!-- DaisyUI Stats -->
			<div
				class="stats stats-vertical lg:stats-horizontal shadow-xl my-6 w-full bg-brand-bg text-brand-text"
			>
				<div class="stat">
					<div
						class="stat-title text-brand-text/70 font-semibold"
					>
						{siteConfig.hours.weekday.days}
					</div>
					<div
						class="stat-value text-2xl text-brand-primary my-2"
					>
						{siteConfig.hours.weekday.time}
					</div>
					<div class="stat-desc">{siteConfig.hours.weekday.notes}</div>
				</div>
				<div class="stat">
					<div
						class="stat-title text-brand-text/70 font-semibold"
					>
						{siteConfig.hours.weekend.days}
					</div>
					<div
						class="stat-value text-2xl text-brand-primary my-2"
					>
						{siteConfig.hours.weekend.time}
					</div>
					<div class="stat-desc">{siteConfig.hours.weekend.notes}</div>
				</div>
			</div>

			<!-- DaisyUI Mockup Window for Map -->
			<div
				class="border border-brand-bg shadow-xl bg-base-300 mt-8 overflow-hidden rounded-2xl"
			>
				<div class="bg-brand-bg">
					<iframe
						src={siteConfig.contact.mapEmbedUrl}
						width="100%"
						height="220"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						title={`Lokasi ${siteConfig.brandName}`}></iframe>
				</div>
			</div>
		</div>

		<!-- Reservation Form (DaisyUI Card) -->
		<div
			id="reservation"
			class="card shrink-0 w-full max-w-md shadow-2xl bg-brand-bg"
		>
			<div class="card-body">
				<h2
					class="card-title justify-center text-3xl font-serif text-brand-primary mb-2"
				>
					Reservasi
				</h2>
				<p class="text-center text-brand-text/70 mb-6 text-sm">
					Amankan tempat favoritmu terlebih dahulu.
				</p>

				<form id="reservation-form">
					<div class="form-control mb-4">
						<label class="label">
							<span
								class="label-text font-medium text-brand-text"
								>Name</span
							>
						</label>
						<input
							type="text"
							id="res-name"
							placeholder="Your Name"
							class="input input-bordered focus:border-brand-primary focus:outline-brand-primary w-full bg-brand-bg-alt"
							required
						/>
					</div>

					<div class="form-control mb-4">
						<label class="label">
							<span
								class="label-text font-medium text-brand-text"
								>Date & Time</span
							>
						</label>
						<input
							type="datetime-local"
							id="res-datetime"
							class="input input-bordered focus:border-brand-primary focus:outline-brand-primary w-full bg-brand-bg-alt"
							required
						/>
					</div>

					<div class="form-control mb-6">
						<label class="label">
							<span
								class="label-text font-medium text-brand-text"
								>Number of Guests</span
							>
						</label>
						<select
							id="res-guests"
							class="select select-bordered focus:border-brand-primary focus:outline-brand-primary w-full bg-brand-bg-alt"
							required
						>
							<option disabled selected value="">Select guests</option>
							<option value="10 People">10 People</option>
							<option value="20 People">20 People</option>
							<option value="30 People">30 People</option>
							<option value="40+ People">40+ People</option>
						</select>
					</div>

					<div class="form-control mt-4">
						<button
							type="submit"
							class="btn bg-brand-primary hover:bg-brand-hover text-white border-none w-full shadow-lg"
							>Confirm Booking</button
						>
					</div>
				</form>
			</div>
		</div>
	</div>
</section>

<script define:vars={{ waNumber: siteConfig.contact.waNumber, brandName: siteConfig.brandName }}>
	const form = document.getElementById("reservation-form");
	
	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		
		const nameInput = document.getElementById("res-name");
		const datetimeInput = document.getElementById("res-datetime");
		const guestsSelect = document.getElementById("res-guests");

		const name = nameInput.value;
		const datetime = datetimeInput.value;
		const guests = guestsSelect.value;
		
		// Format datetime to be more readable
		const dateObj = new Date(datetime);
		const formattedDate = dateObj.toLocaleString('id-ID', { 
			weekday: 'long', 
			year: 'numeric', 
			month: 'long', 
			day: 'numeric',
			hour: '2-digit',
			minute: '2-digit'
		});

		// Create WhatsApp message
		const message = `Halo ${brandName}! Saya ingin melakukan reservasi meja.

Detail Reservasi:
- Nama: ${name}
- Waktu: ${formattedDate}
- Jumlah Tamu: ${guests}

Mohon konfirmasinya. Terima kasih!`;

		const whatsappUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;

		// Open in new tab
		window.open(whatsappUrl, "_blank");
	});
</script>
