---
const testimonials = [
	{
		name: "Dinda Ayu",
		role: "Pengunjung Setia",
		quote:
			"Tempat favorit untuk kerja remote. Kopinya konsisten enak dan suasananya selalu menenangkan.",
		avatar: "https://i.pravatar.cc/100?img=47",
	},
	{
		name: "Rizky Pratama",
		role: "Coffee Enthusiast",
		quote:
			"Single origin-nya luar biasa. Barista-nya sangat paham soal kopi dan selalu memberi rekomendasi terbaik.",
		avatar: "https://i.pravatar.cc/100?img=12",
	},
	{
		name: "Sarah Wijaya",
		role: "Mahasiswi",
		quote:
			"Sedapnya Aruna Latte bikin ketagihan. Tempat yang nyaman untuk nongkrong bareng teman-teman.",
		avatar: "https://i.pravatar.cc/100?img=44",
	},
];
---

<!-- Testimonials Section -->
<section id="testimonials" class="py-24 bg-brand-bg-alt">
	<div class="container mx-auto px-6 lg:px-12 max-w-7xl">
		<div
			class="divider text-4xl md:text-5xl font-serif font-bold text-brand-primary mb-16"
		>
			Kata Mereka
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{
				testimonials.map((testimonial) => (
					<div
						class="card bg-brand-bg shadow-xl hover:-translate-y-2 transition-transform duration-300"
					>
						<div class="card-body">
							<div class="flex items-center gap-1 mb-3">
								{
									Array.from({ length: 5 }).map(() => (
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 24 24"
											fill="var(--color-brand-primary)"
											class="w-5 h-5"
										>
											<path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
										</svg>
									))
								}
							</div>
							<p class="text-brand-text/80 italic">
								"{testimonial.quote}"
							</p>
							<div class="flex items-center gap-3 mt-6">
								<div class="avatar">
									<div
										class="w-12 h-12 rounded-full ring-2 ring-brand-primary/30"
									>
										<img
											src={testimonial.avatar}
											alt={testimonial.name}
										/>
									</div>
								</div>
								<div>
									<h3 class="font-semibold text-brand-text">
										{testimonial.name}
									</h3>
									<p class="text-sm text-brand-primary">
										{testimonial.role}
									</p>
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
