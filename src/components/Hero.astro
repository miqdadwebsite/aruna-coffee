---
import { siteConfig } from "../data/config";
---

<!-- Hero Section (Rounded Container) -->
<div class="px-4 lg:px-8 pt-24 pb-0 bg-brand-bg">
	<header
		class="hero min-h-[85vh] rounded-3xl overflow-hidden"
		style={`background-image: url('${siteConfig.hero.image}');`}
	>
		<div class="hero-overlay bg-black/60"></div>
		<div
			class="hero-content text-neutral-content text-center animate-fade-in-up"
		>
			<div class="max-w-xl">
				<h1
					class="mb-5 text-5xl md:text-7xl font-bold font-serif text-white drop-shadow-xl"
				>
					{siteConfig.hero.title}
				</h1>
				<p class="mb-2 text-xl md:text-2xl font-light text-white/90">
					{siteConfig.hero.subtitle}
				</p>
				{
					siteConfig.hero.subSubtitle && (
						<p class="mb-8 text-base md:text-lg font-light text-white/75">
							{siteConfig.hero.subSubtitle}
						</p>
					)
				}
				<div class="gap-4 flex justify-center">
					<a
						href="#reservation"
						class="btn bg-brand-primary hover:bg-brand-hover text-white border-none btn-lg rounded-full px-10 shadow-lg"
						>Book a Table</a
					>
					<a
						href="#menu"
						class="btn btn-secondary bg-transparent hover:bg-brand-secondary text-white btn-lg rounded-full px-10 shadow-lg"
						>Lihat Menu</a
					>
				</div>
			</div>
		</div>
	</header>
</div>

<style>
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.animate-fade-in-up {
		animation: fadeInUp 1.5s ease-out;
	}
</style>
