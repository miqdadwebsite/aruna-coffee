<!-- Brand Story Section -->
<section id="story" class="hero py-24 bg-brand-bg text-brand-text">
	<div
		class="hero-content flex-col lg:flex-row gap-12 lg:gap-24 w-full max-w-6xl"
	>
		<img
			src="https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&q=80&w=800&h=800"
			alt="Barista pouring coffee"
			class="max-w-sm w-full rounded-box shadow-2xl mask mask-squircle"
		/>
		<div>
			<div
				class="divider divider-start text-4xl md:text-5xl font-serif font-bold text-brand-primary mb-8"
			>
				Tentang Aruna
			</div>
			<p class="text-lg text-brand-text/80 mb-6">
				Aruna berarti cahaya pagi. Terinspirasi dari awal hari yang
				tenang, kami menciptakan ruang untuk menikmati kopi, berbagi
				cerita, dan meluangkan waktu.
			</p>
			<p class="text-lg text-brand-text/80">
				Setiap cangkir kami siapkan dengan biji kopi pilihan dan
				perhatian pada setiap detail.
			</p>
		</div>
	</div>
</section>
