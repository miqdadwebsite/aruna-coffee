---
const menuItems = [
	{
		title: "Aruna Latte",
		description:
			"Our classic espresso with perfectly steamed milk and a hint of homemade vanilla syrup.",
		image: "https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&q=80&w=400&h=300",
		badge: {
			text: "Bestseller",
			class: "bg-brand-primary text-white border-none",
		},
		tags: ["Hot", "Iced"],
		isHidden: false,
	},
	{
		title: "24-Hour Cold Brew",
		description:
			"Steeped for a full day for a smooth, bold, and refreshing flavor profile with low acidity.",
		image: "https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&q=80&w=400&h=300",
		badge: { text: "New", class: "badge-secondary border-none" },
		tags: ["Iced Only"],
		isHidden: false,
	},
	{
		title: "Single Origin",
		description:
			"Experience the distinct tasting notes of our rotating seasonal beans, manually brewed.",
		image: "https://images.unsplash.com/photo-1620189507195-68309c04c4d0?auto=format&fit=crop&q=80&w=400&h=300",
		tags: ["V60", "Chemex"],
		isHidden: false,
	},
	{
		title: "Double Espresso",
		description:
			"A concentrated double shot of our house blend — bold, rich, and full of character.",
		image: "https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&q=80&w=400&h=300",
		tags: ["Hot"],
		isHidden: false,
	},
	{
		title: "Matcha Latte",
		description:
			"Ceremonial grade matcha whisked to perfection, paired with creamy oat milk.",
		image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&q=80&w=400&h=300",
		tags: ["Hot", "Iced"],
		isHidden: false,
	},
	{
		title: "Butter Croissant",
		description:
			"Flaky, golden, and buttery. Baked fresh every morning in our kitchen.",
		image: "https://images.unsplash.com/photo-1621939514649-280e2ee25f60?auto=format&fit=crop&q=80&w=400&h=300",
		tags: ["Food"],
		isHidden: false,
	},
	{
		title: "Cappuccino",
		description:
			"Equal parts espresso, steamed milk, and velvety foam — a timeless classic.",
		image: "https://images.unsplash.com/photo-1571066811602-716837d681de?auto=format&fit=crop&q=80&w=400&h=300",
		tags: ["Hot"],
		isHidden: true,
	},
	{
		title: "Almond Danish",
		description:
			"A delicate pastry layered with almond cream and topped with toasted almond flakes.",
		image: "https://images.unsplash.com/photo-1558961363-fa8fdf82db35?auto=format&fit=crop&q=80&w=400&h=300",
		tags: ["Food"],
		isHidden: true,
	},
];
---

<!-- Signature Menu Section -->
<section id="menu" class="py-24 bg-brand-bg-alt">
	<div class="container mx-auto px-6 lg:px-12 max-w-7xl">
		<div
			class="divider text-4xl md:text-5xl font-serif font-bold text-brand-primary mb-16"
		>
			Signature Menu
		</div>

		<div
			id="menu-grid"
			class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
		>
			{
				menuItems.map((item) => (
					<div
						class={`menu-card card bg-brand-bg shadow-xl hover:-translate-y-2 transition-transform duration-300 ${item.isHidden ? "menu-extra hidden" : ""}`}
					>
						<figure>
							<img
								src={item.image}
								alt={item.title}
								class="w-full h-64 object-cover"
							/>
						</figure>
						<div class="card-body">
							<h2 class="card-title text-brand-primary font-serif text-2xl">
								{item.title}
								{item.badge && (
									<div class={`badge ${item.badge.class}`}>
										{item.badge.text}
									</div>
								)}
							</h2>
							<p class="text-brand-text/70 mt-2">
								{item.description}
							</p>
							<div class="card-actions justify-end mt-4">
								{item.tags?.map((tag) => (
									<div class="badge badge-outline border-brand-primary text-brand-primary p-3">
										{tag}
									</div>
								))}
							</div>
						</div>
					</div>
				))
			}
		</div>

		<!-- Load More Button -->
		<div id="load-more-wrapper" class="flex justify-center mt-12">
			<button
				id="load-more-btn"
				class="btn bg-brand-primary hover:bg-brand-hover text-white border-none rounded-full px-10"
			>
				Load More
			</button>
		</div>
	</div>
</section>

<script>
	const loadMoreBtn = document.getElementById("load-more-btn");
	const loadMoreWrapper = document.getElementById("load-more-wrapper");
	const extraCards = document.querySelectorAll<HTMLElement>(".menu-extra");

	loadMoreBtn?.addEventListener("click", () => {
		extraCards.forEach((card) => {
			card.classList.remove("hidden");
		});
		loadMoreWrapper?.remove();
	});
</script>
